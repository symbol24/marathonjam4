[internationalization]

locale/translations=PackedStringArray("res://Data/Loacalization/loacalization.en.translation", "res://Data/Loacalization/loacalization.fr.translation", "res://Data/Loacalization/loacalization.fr_CA.translation")

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player characters"
2d_physics/layer_3="interactables"
2d_physics/layer_4="enemies"
2d_physics/layer_5="player attacks"
2d_physics/layer_6="enemy attacks"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0745098, 0.0745098, 0.0745098, 1)
