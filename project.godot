; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Prisoner Hulk"
run/main_scene="res://Scenes/utilities/boot.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="prirate_hulk"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/image="res://Textures/Logos/logo_back_mini.png"
config/icon="res://icon.svg"

[autoload]

Signals="*res://Code/Autoload/signal_bus.gd"
Audio="*res://addons/AudioBySymbol/Code/Autoloads/audio_autoload.gd"
Debug="*res://Code/Debug/debug.gd"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/AudioBySymbol/plugin.cfg", "res://addons/crt_shader/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg")

[file_customization]

folder_colors={
"res://Audio/": "blue",
"res://Code/": "yellow",
"res://Data/": "purple",
"res://Scenes/": "red",
"res://Textures/": "green"
}

[global_group]

data_manager=""
play_level=""
scene_manager=""
game_manager=""
element=""
save_manager=""
input_manager=""
UI=""
prisoner=""
unknown_contact=""
enemy_spawn_tag=""

[gui]

theme/custom="res://Data/default_theme.tres"
theme/custom_font="res://Data/Fonts/80s-retro-future.ttf"

[input]

mouse_left={
